# Semente Toy App (Echo domain) — environment configuration
# Copy to .env and fill in your values.

APP_ENV=development

# Model provider: google (Gemini) or ollama (local)
PRIMARY_MODEL_PROVIDER=google
PRIMARY_MODEL_ID=gemini-3.5-flash-lite
GOOGLE_API_KEY=

# Ollama (only if PRIMARY_MODEL_PROVIDER=ollama)
# PRIMARY_MODEL_PROVIDER=ollama
# PRIMARY_MODEL_ID=gemma4:31b-cloud
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_API_KEY=ollama

# Optional fallback model
# FALLBACK_MODEL_PROVIDER=ollama
# FALLBACK_MODEL_ID=gemma4:31b-cloud
